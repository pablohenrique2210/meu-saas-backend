# Backend NestJS
PORT=4000
API_PUBLIC_URL=https://SEU-BACKEND.up.railway.app
UPLOADS_DIR=/app/uploads
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Clerk (use chaves de produção no ambiente publicado)
CLERK_SECRET_KEY=sk_live_...
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CLERK_AUTHORIZED_PARTIES=https://SEU-FRONT.vercel.app

# Endereços autorizados a abrir e consumir a área de RH.
# Informe exatamente dois e-mails, separados por vírgula.
RH_ALLOWED_EMAILS=pablohenrique2210@gmail.com,consultoria@lilianarruda.com.br

# Origens do frontend autorizadas a chamar a API, separadas por vírgula.
FRONTEND_URLS=https://SEU-FRONT.vercel.app,http://localhost:3000

# Armazenamento permanente para imagens, vídeos e materiais.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
